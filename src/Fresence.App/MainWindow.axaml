<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="320"
        x:Class="Fresence.App.MainWindow"
        Title="Fresence"
        Width="460"
        Height="320">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Discord Application ID" />
        <TextBox Name="ApplicationIdTextBox"
                 PlaceholderText="輸入 Discord Application ID" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="StartButton" Content="開始同步" />
            <Button Name="StopButton" Content="停止同步" IsEnabled="False" />
        </StackPanel>

        <TextBlock Name="StatusTextBlock" Text="尚未開始同步" />

        <Border Padding="12" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Spacing="4">
                <TextBlock Name="SourceTextBlock" Text="來源：—" />
                <TextBlock Name="TrackTextBlock" Text="歌曲：—" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
