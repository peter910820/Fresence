<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DiscordApplicationId Condition="'$(DiscordApplicationId)' == ''"></DiscordApplicationId>
    <BuildConstantsFile>$(MSBuildThisFileDirectory)BuildConstants.fs</BuildConstantsFile>
  </PropertyGroup>

  <Target Name="GenerateBuildConstants" BeforeTargets="PrepareForBuild;BeforeCompile">
    <PropertyGroup>
      <_EscapedDiscordApplicationId>$([System.String]::Copy('$(DiscordApplicationId)').Replace('\','\\').Replace('"','\"'))</_EscapedDiscordApplicationId>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildConstantsFile)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="namespace Fresence.App%0A%0Amodule BuildConstants =%0A    let DiscordApplicationId = &quot;$(_EscapedDiscordApplicationId)&quot;" />
  </Target>

  <ItemGroup>
    <Compile Include="BuildConstants.fs" />
    <Compile Include="PresenceSynchronizer.fs" />
    <Compile Include="MainWindow.axaml.fs" />
    <Compile Include="App.axaml.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <ProjectReference Include="..\Fresence.Media\Fresence.Media.fsproj" />
    <ProjectReference Include="..\Fresence.Discord\Fresence.Discord.fsproj" />
  </ItemGroup>
</Project>
